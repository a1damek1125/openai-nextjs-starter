# Finalis Portal — local development configuration
# Copy to .env and adjust. NO real secrets in this file.

# Session-token signing secret (change for any shared deployment)
FINALIS_SECRET=dev-secret-change-me

# SQLite database file for the dev portal (Postgres swap: see
# docs/finalis-ai/working-portal/founder-cto-report.md)
FINALIS_DB=finalis-dev.db

# --- Real providers: all OPTIONAL, portal runs fully on mocks without them ---
# WhatsApp (Meta Cloud API) — Requires external provider + credentials
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Twilio SMS fallback — Requires credentials
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SMTP email — Requires credentials
# SMTP_URL=
# Chatwoot (self-hosted) — Requires external service
# CHATWOOT_URL=
# CHATWOOT_API_TOKEN=
# Temporal — Requires external service
# TEMPORAL_ADDRESS=
